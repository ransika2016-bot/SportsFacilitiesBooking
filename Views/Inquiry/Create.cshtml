@model SportsBookingSystem.Models.Inquiry

@{
    ViewData["Title"] = "Contact Us";
}

<div class="container page-container">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="form-card">
                <div class="form-card-header">
                    <div class="icon-circle" style="background: #e0f2fe; color: #0284c7;">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <h4>Contact Sports Council</h4>
                    <p>We'd love to hear from you</p>
                </div>
                <div class="form-card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.GuestName, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.GuestName, new { @class = "form-control", placeholder = "Your name" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.GuestEmail, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.GuestEmail, new { @class = "form-control", placeholder = "you@email.com" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Subject, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Subject, new { @class = "form-control", placeholder = "How can we help?" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.MessageText, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.MessageText, new { @class = "form-control", rows = 5, placeholder = "Your message..." })
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-send me-2"></i>Send Inquiry
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

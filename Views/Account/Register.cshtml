@model SportsBookingSystem.Models.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="container page-container">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="auth-card">
                <div class="auth-card-header">
                    <div class="icon-circle"><i class="bi bi-person-plus-fill"></i></div>
                    <h4>Create Your Account</h4>
                    <p>Join the community and start booking today</p>
                </div>
                <div class="auth-card-body">
                    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(false, "", new { @class = "text-danger small" })

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.FirstName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "First name" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.LastName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Last name" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "you@email.com", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Min. 6 characters" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm password" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "e.g., 0712345678" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Your home address" })
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Preferred Sports</label>
                            <div class="row g-2">
                                @foreach (var sport in ViewBag.Sports)
                                {
                                    <div class="col-md-4 col-6">
                                        <div class="form-check">
                                            <input type="checkbox" name="SelectedSportIDs" value="@sport.SportID"
                                                   class="form-check-input" id="sport_@sport.SportID" />
                                            <label class="form-check-label" for="sport_@sport.SportID">@sport.SportName</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">Create Account</button>
                    }
                    <div class="text-center mt-4">
                        <span class="text-muted small">Already have an account?</span>
                        <a href="@Url.Action("Login", "Account")" class="fw-semibold">Sign in</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

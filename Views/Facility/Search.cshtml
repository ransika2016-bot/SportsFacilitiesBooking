@model IEnumerable<SportsBookingSystem.Models.Facility>

@{
    ViewData["Title"] = "Search Facilities";
    bool isMember = Context.Session.GetInt32("MemberID") != null;
}

<div class="container page-container">
    <div class="page-header">
        <h2><i class="bi bi-search text-primary me-2"></i>Search Sports Facilities</h2>
        <p>Find the perfect venue by type or location</p>
    </div>

    <div class="search-panel">
        @using (Html.BeginForm("Search", "Facility", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="@(isMember ? "col-md-2" : "col-md-4")">
                <label class="form-label">Facility Type</label>
                @Html.DropDownList("facilityTypeId", (SelectList)ViewBag.FacilityTypes, "All Types", new { @class = "form-select" })
            </div>
            <div class="@(isMember ? "col-md-3" : "col-md-4")">
                <label class="form-label">Location</label>
                <input type="text" name="location" class="form-control" placeholder="e.g. Downtown" />
            </div>
            @if (isMember)
            {
                <div class="col-md-3">
                    <label class="form-label">Booking Date</label>
                    <input type="date" name="bookingDate" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Start Time</label>
                    <input type="time" name="startTime" class="form-control" />
                </div>
            }
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Search
                </button>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-emoji-frown d-block"></i>
            <h5>No facilities found</h5>
            <p class="text-muted">Try adjusting your search filters.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var facility in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="facility-card">
                        <div class="facility-card-img">
                            <img src="@(!string.IsNullOrEmpty(facility.ImageUrl) ? facility.ImageUrl : "/images/default.jpg")" 
                                 alt="@facility.FacilityName"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/default.jpg';"
                                 style="width:100%;height:100%;object-fit:cover;display:block;" />
                        </div>
                        <div class="facility-card-body">
                            <h5 class="facility-card-title">@facility.FacilityName</h5>
                            <p class="facility-card-text">@facility.Description</p>
                            <div class="facility-meta">
                                <i class="bi bi-pin-map"></i> @facility.Location
                            </div>
                        </div>
                        <div class="facility-card-footer">
                            <a href="@Url.Action("Details", "Facility", new { id = facility.FacilityID })"
                               class="btn btn-outline-primary btn-sm">Details</a>
                            @if (isMember)
                            {
                                <a href="@Url.Action("Create", "Booking", new { facilityId = facility.FacilityID })"
                                   class="btn btn-primary btn-sm">Book Now</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-link text-muted">Login to book</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

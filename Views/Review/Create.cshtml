@model SportsBookingSystem.Models.Review

@{
    ViewData["Title"] = "Write a Review";
}

<div class="container page-container">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="form-card">
                <div class="form-card-header">
                    <div class="icon-circle" style="background: #fef3c7; color: #d97706;">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <h4>Write a Review</h4>
                    <p>@ViewBag.FacilityName</p>
                </div>
                <div class="form-card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.BookingID)
                        @Html.HiddenFor(m => m.FacilityID)
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Rating, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.Rating,
                                Enumerable.Range(1, 5).Select(i => new SelectListItem { Value = i.ToString(), Text = $"{i} Star{(i > 1 ? "s" : "")}" }),
                                new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CommentText, "Your Review", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.CommentText, new { @class = "form-control", rows = 4, placeholder = "Share your experience..." })
                        </div>

                        <div class="form-check mb-4">
                            @Html.CheckBoxFor(m => m.IsAnonymous, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.IsAnonymous, "Submit anonymously", new { @class = "form-check-label" })
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-send me-2"></i>Submit Review
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@model IEnumerable<SportsBookingSystem.Models.Review>

@functions {
    string RenderStars(int rating)
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 1; i <= 5; i++)
        {
            sb.Append(i <= rating ? "<i class=\"bi bi-star-fill\"></i>" : "<i class=\"bi bi-star\"></i>");
        }
        return sb.ToString();
    }
}

@{
    ViewData["Title"] = "Reviews";
}

<div class="container page-container">
    <div class="page-header">
        <h2><i class="bi bi-star-fill text-warning me-2"></i>Member Reviews</h2>
        <p>See what our community thinks about the facilities</p>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-chat-square-text d-block"></i>
            <h5>No reviews yet</h5>
            <p class="text-muted">Book a facility and share your experience!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var review in Model)
            {
                <div class="col-md-6">
                    <div class="review-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="mb-1 fw-bold">@review.Facility?.FacilityName</h5>
                                <div class="text-muted small">
                                    <i class="bi bi-person me-1"></i>
                                    @(review.IsAnonymous ? "Anonymous" : $"{review.Member?.FirstName} {review.Member?.LastName}")
                                    · @review.ReviewDate.ToString("MMM dd, yyyy")
                                </div>
                            </div>
                            <div>
                                <span class="star-rating">@Html.Raw(RenderStars(review.Rating))</span>
                                <span class="text-muted small ms-1">(@review.Rating/5)</span>
                            </div>
                        </div>
                        <p class="mb-0">@review.CommentText</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

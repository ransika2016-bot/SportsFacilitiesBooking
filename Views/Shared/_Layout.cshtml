<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-trophy-fill"></i> SportBook
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Facility" asp-action="Search"><i class="bi bi-search me-1"></i> Facilities</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Review" asp-action="Index"><i class="bi bi-star me-1"></i> Reviews</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Inquiry" asp-action="Create"><i class="bi bi-envelope me-1"></i> Contact</a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-1">
                    @if (Context.Session.GetInt32("MemberID") != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link user-greeting">
                                <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("MemberName")
                            </span>
                        </li>
                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i> Admin Panel</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="MyBookings"><i class="bi bi-calendar-check me-1"></i> My Bookings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-nav-cta" asp-controller="Account" asp-action="GuestRegister">
                                <i class="bi bi-person-plus me-1"></i>Become a Member
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="page-main">
        @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
        {
            <div class="container pt-3">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="footer-brand"><i class="bi bi-trophy-fill me-2"></i>SportBook</div>
                    <p class="small mb-0">Book community sports facilities, manage your reservations, and share your experience.</p>
                </div>
                <div class="col-md-4 mb-4 mb-md-0">
                    <h6 class="text-white mb-3">Quick Links</h6>
                    <div class="d-flex flex-column gap-2 small">
                        <a asp-controller="Facility" asp-action="Search">Browse Facilities</a>
                        <a asp-controller="Review" asp-action="Index">Member Reviews</a>
                        <a asp-controller="Inquiry" asp-action="Create">Contact Us</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white mb-3">Get Started</h6>
                    <div class="d-flex flex-column gap-2 small">
                        <a asp-controller="Account" asp-action="GuestRegister">Become a Member</a>
                        <a asp-controller="Account" asp-action="Login">Member Login</a>
                        <a asp-controller="Booking" asp-action="MyBookings">My Bookings</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; @DateTime.Now.Year Municipal Sports Council. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
    (function () {
        var nav = document.querySelector('.app-navbar');
        if (!nav) return;
        function updateNav() { nav.classList.toggle('scrolled', window.scrollY > 40); }
        window.addEventListener('scroll', updateNav, { passive: true });
        updateNav();
    })();

    (function () {
        document.querySelectorAll('.facility-card, .review-card, .stat-card, .auth-card, .details-card')
            .forEach(function (el, i) {
                el.classList.add('reveal');
                el.style.transitionDelay = (i * 0.07) + 's';
            });

        if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) {
                        e.target.classList.add('visible');
                        io.unobserve(e.target);
                    }
                });
            }, { threshold: 0.12 });
            document.querySelectorAll('.reveal').forEach(function(el) { io.observe(el); });
        } else {
            document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
        }

        var counters = document.querySelectorAll('.stat-card strong');
        if (counters.length && 'IntersectionObserver' in window) {
            var io2 = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (!e.isIntersecting) return;
                    var el = e.target;
                    var target = parseFloat(el.textContent.replace(/[^0-9.]/g, ''));
                    if (isNaN(target)) return;
                    var suffix = el.textContent.replace(/[\d.]/g, '');
                    var start = 0, duration = 900, step = 16;
                    var timer = setInterval(function () {
                        start += (target / (duration / step));
                        if (start >= target) { start = target; clearInterval(timer); }
                        el.textContent = Math.floor(start) + suffix;
                    }, step);
                    io2.unobserve(el);
                });
            }, { threshold: 0.5 });
            counters.forEach(function(el) { io2.observe(el); });
        }

        document.querySelectorAll('.reveal').forEach(function(el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight) el.classList.add('visible');
        });
    })();

    document.querySelectorAll('.btn').forEach(function (btn) {
        btn.addEventListener('mousedown', function () { btn.style.transform = 'scale(0.97)'; });
        btn.addEventListener('mouseup', function () { btn.style.transform = ''; });
        btn.addEventListener('mouseleave', function () { btn.style.transform = ''; });
    });
    </script>
</body>
</html>

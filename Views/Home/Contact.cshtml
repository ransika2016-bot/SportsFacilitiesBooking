@{
    ViewData["Title"] = "Contact";
}

<div class="container page-container">
    <div class="page-header text-center">
        <h2><i class="bi bi-headset text-primary me-2"></i>Get in Touch</h2>
        <p>Have a question? Our team is here to help.</p>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="search-panel">
                <i class="bi bi-envelope-paper display-4 text-primary mb-3 d-block"></i>
                <p class="text-muted mb-4">Send us an inquiry and we'll get back to you as soon as possible.</p>
                <a asp-controller="Inquiry" asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-send me-2"></i>Send Inquiry
                </a>
            </div>
        </div>
    </div>
</div>

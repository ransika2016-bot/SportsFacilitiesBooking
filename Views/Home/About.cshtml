@{
    ViewData["Title"] = "About";
}

<div class="container page-container">
    <div class="details-card">
        <div class="details-hero">
            <h1>About SportBook</h1>
            <p class="mb-0 opacity-75">Your community sports booking platform</p>
        </div>
        <div class="details-body">
            <p class="lead">The Municipal Sports Council provides community sports facilities for residents to stay active, connect, and enjoy recreational activities.</p>
            <div class="row g-4 mt-2">
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-search"></i>
                        <strong>Discover</strong>
                        <span>Find venues near you</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-calendar-plus"></i>
                        <strong>Book</strong>
                        <span>Reserve in seconds</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-star"></i>
                        <strong>Review</strong>
                        <span>Share your experience</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
